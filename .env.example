# VayuShetra API Credentials Configuration
# Copy this file to .env and fill in your credentials

# NASA FIRMS API Map Key (https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=

# OpenAQ API Key for CPCB Ground Station Sync (https://openaq.org/)
OPENAQ_API_KEY=

# Google Earth Engine Service Account Credentials
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_PATH=

# Note: Copernicus CDS ERA5 API key should be placed in C:\Users\HP\.cdsapirc (Windows) or ~/.cdsapirc (Linux/Mac)
# Format of .cdsapirc:
# url: https://cds.climate.copernicus.eu/api
# key: YOUR_PERSONAL_ACCESS_TOKEN
